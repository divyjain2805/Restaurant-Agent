# LLM 1: Groq API Key (High-Speed Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM 2: Google Gemini API Key (Dual Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database: MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=restaurant_db

# Server Port (Optional, default 8000)
PORT=8000
